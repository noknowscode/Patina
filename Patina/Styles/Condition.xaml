<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Rung 4 custom tokens: Material has no ordinal status ramp. These fill the condition strip's patches and the map
    pins (Controls/ArtworkMap.cs reads them by key and redraws on ActualThemeChanged).
    The grade values are the same in both themes by design: each clears 3:1 non-text contrast on Surface and
    Background in both (#F8F9F6, #EEF0EC, #1D1E1C, #151614; worst case 3.44:1), so a grade looks the same by day and
    at night. They sit in Light and Dark dictionaries (Default = Dark) so a theme can retune them without touching the
    pages. Patches never carry text; the grade numeral and word beside them use OnSurfaceBrush.
    Grade is never color alone: patch count + numeral + word.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- xaml-lint: allow hex - palette token file for the condition ramp, contrast-checked in both themes -->
      <Color x:Key="Grade1InvariantColor">#3E8762</Color>
      <Color x:Key="Grade2InvariantColor">#9C7C22</Color>
      <Color x:Key="Grade3InvariantColor">#C0632A</Color>
      <Color x:Key="Grade4InvariantColor">#D04436</Color>
      <!-- Map pins: unsurveyed works are stone grey; the ring separates a pin from the tiles -->
      <Color x:Key="GradeUnsurveyedColor">#8A9490</Color>
      <Color x:Key="MapPinRingColor">#FFFFFF</Color>
      <Color x:Key="MapPinSelectedRingColor">#1C2321</Color>
      <SolidColorBrush x:Key="Grade1InvariantBrush" Color="{StaticResource Grade1InvariantColor}" />
      <SolidColorBrush x:Key="Grade2InvariantBrush" Color="{StaticResource Grade2InvariantColor}" />
      <SolidColorBrush x:Key="Grade3InvariantBrush" Color="{StaticResource Grade3InvariantColor}" />
      <SolidColorBrush x:Key="Grade4InvariantBrush" Color="{StaticResource Grade4InvariantColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- xaml-lint: allow hex - palette token file for the condition ramp, contrast-checked in both themes -->
      <Color x:Key="Grade1InvariantColor">#3E8762</Color>
      <Color x:Key="Grade2InvariantColor">#9C7C22</Color>
      <Color x:Key="Grade3InvariantColor">#C0632A</Color>
      <Color x:Key="Grade4InvariantColor">#D04436</Color>
      <!-- Map pins: unsurveyed works are stone grey; the ring separates a pin from the tiles -->
      <Color x:Key="GradeUnsurveyedColor">#8A9490</Color>
      <Color x:Key="MapPinRingColor">#FFFFFF</Color>
      <Color x:Key="MapPinSelectedRingColor">#1C2321</Color>
      <SolidColorBrush x:Key="Grade1InvariantBrush" Color="{StaticResource Grade1InvariantColor}" />
      <SolidColorBrush x:Key="Grade2InvariantBrush" Color="{StaticResource Grade2InvariantColor}" />
      <SolidColorBrush x:Key="Grade3InvariantBrush" Color="{StaticResource Grade3InvariantColor}" />
      <SolidColorBrush x:Key="Grade4InvariantBrush" Color="{StaticResource Grade4InvariantColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default"> <!-- Default = Dark -->
      <!-- xaml-lint: allow hex - palette token file for the condition ramp, contrast-checked in both themes -->
      <Color x:Key="Grade1InvariantColor">#3E8762</Color>
      <Color x:Key="Grade2InvariantColor">#9C7C22</Color>
      <Color x:Key="Grade3InvariantColor">#C0632A</Color>
      <Color x:Key="Grade4InvariantColor">#D04436</Color>
      <!-- Map pins: unsurveyed works are stone grey; the ring separates a pin from the tiles -->
      <Color x:Key="GradeUnsurveyedColor">#8A9490</Color>
      <Color x:Key="MapPinRingColor">#FFFFFF</Color>
      <Color x:Key="MapPinSelectedRingColor">#1C2321</Color>
      <SolidColorBrush x:Key="Grade1InvariantBrush" Color="{StaticResource Grade1InvariantColor}" />
      <SolidColorBrush x:Key="Grade2InvariantBrush" Color="{StaticResource Grade2InvariantColor}" />
      <SolidColorBrush x:Key="Grade3InvariantBrush" Color="{StaticResource Grade3InvariantColor}" />
      <SolidColorBrush x:Key="Grade4InvariantBrush" Color="{StaticResource Grade4InvariantColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
