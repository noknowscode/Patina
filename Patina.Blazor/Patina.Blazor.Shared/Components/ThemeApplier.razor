@inject IAppSettings Settings
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Puts the saved theme and motion choice on <html> once the page is live; Settings calls Apply after a change. *@

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyAsync();
        }
    }

    public async Task ApplyAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Patina.Blazor.Shared/js/patina.js");
            await _module.InvokeVoidAsync("applyTheme", Settings.Theme.ToString(), Settings.ReduceMotion);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no JS yet. The web head renders the attributes server-side instead.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
